#!name=Loon 面板
#!desc=给 Scripting「Loon 面板」小组件提供数据：定时体检节点（延迟和出口），小组件读取运行模式、策略组和当前节点，并可在桌面上切换。数据地址 http://1.1.1.1/loon-panel/data
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/patch/tree/main/scripting/loon-panel
#!loon_version = 3.5.1(983)
#!tag=小组件, 节点

[Argument]
cron = input,"*/30 * * * *",tag=体检频率,desc=Cron 表达式，默认每 30 分钟一次
groups = input,"",tag=全量体检的策略组,desc=选填。默认只测各策略组当前选中的节点；填在这里的策略组会测全部节点，多个用英文逗号分隔
timeout = input,3000,type=number,tag=单次超时（毫秒）,desc=超过这个时间判为不可用
test_url = input,"http://www.gstatic.com/generate_204",tag=测速地址
ip_url = input,"https://api.ipify.org",tag=出口 IP 地址,desc=返回出口 IP 的地址，纯文本或带 ip 字段的 JSON 都可以

[Script]
cron ${cron} then script("https://raw.githubusercontent.com/MaYIHEI/patch/refs/heads/main/scripting/loon-panel/loon/loon-panel.js", {${groups}, ${timeout}, ${test_url}, ${ip_url}}) with tag="节点体检", img_url="stethoscope.system", timeout=120
# 小组件数据和操作: 请求 http://1.1.1.1/loon-panel/data 或 /set 时直接返回 JSON
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/loon-panel\/(data|set)(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/patch/refs/heads/main/scripting/loon-panel/loon/loon-panel.js", {${groups}, ${timeout}, ${test_url}, ${ip_url}}) with tag="Loon 面板数据", img_url="gauge.with.dots.needle.67percent.system", timeout=30
