#!name=Loon 面板
#!desc=给 Scripting「Loon 面板」小组件提供数据：定时体检节点（延迟、出口、解锁），网络切换后自动复测，节点挂了发通知或自动切换，锁定的策略组被还原时改回来；小组件可切换模式和节点。数据地址 http://1.1.1.1/loon-panel/data
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/patch/tree/main/scripting/loon-panel
#!loon_version = 3.5.1(983)
#!tag=小组件, 节点

[Argument]
cron = input,"*/30 * * * *",tag=体检频率,desc=Cron 表达式，默认每 30 分钟一次
groups = input,"",tag=全量体检的策略组,desc=选填。默认只测各策略组当前选中的节点；填在这里的策略组会测全部节点，多个用英文逗号分隔
net_retest = switch,true,tag=网络切换后自动复测,desc=Wi-Fi 和蜂窝切换时体检当前节点
notify = switch,true,tag=节点异常发通知,desc=当前节点连续 3 次超时、锁定的策略组被改回时发通知
auto_switch = switch,false,tag=挂了自动切到最快,desc=当前节点连续 3 次超时时，切到同一策略组里体检过且能用的最快节点。会改 Loon 的策略选择，默认关闭；锁定的策略组不会切
timeout = input,3000,type=number,tag=单次超时（毫秒）,desc=超过这个时间判为不可用
test_url = input,"http://www.gstatic.com/generate_204",tag=测速地址
ip_url = input,"https://api.ipify.org",tag=出口 IP 地址,desc=返回出口 IP 的地址，纯文本或带 ip 字段的 JSON 都可以
push_key = input,"",tag=【小组件推送】推送密钥,desc=选填。App 设置里「体检完自动刷新小组件」复制的 push_key=；发送密钥只勾 widgets:reload；留空则不推送
widget_targets = input,"",tag=【小组件推送】小组件 ID,desc=选填。复制的 widget_targets=，多个用英文逗号分隔

[Script]
cron ${cron} then script("https://raw.githubusercontent.com/MaYIHEI/patch/refs/heads/main/scripting/loon-panel/loon/loon-panel.js", {${groups}, ${net_retest}, ${notify}, ${auto_switch}, ${timeout}, ${test_url}, ${ip_url}, ${push_key}, ${widget_targets}}) with tag="节点体检", img_url="stethoscope.system", timeout=120
network-changed then script("https://raw.githubusercontent.com/MaYIHEI/patch/refs/heads/main/scripting/loon-panel/loon/loon-panel.js", {${groups}, ${net_retest}, ${notify}, ${auto_switch}, ${timeout}, ${test_url}, ${ip_url}, ${push_key}, ${widget_targets}}) with tag="网络切换复测", img_url="wifi.system", timeout=60, enable=${net_retest}
# 小组件数据和操作: 请求 http://1.1.1.1/loon-panel/data 或 /set 时直接返回 JSON
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/loon-panel\/(data|set)(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/patch/refs/heads/main/scripting/loon-panel/loon/loon-panel.js", {${groups}, ${net_retest}, ${notify}, ${auto_switch}, ${timeout}, ${test_url}, ${ip_url}, ${push_key}, ${widget_targets}}) with tag="Loon 面板数据", img_url="gauge.with.dots.needle.67percent.system", timeout=30
# 深度检测: App 手动触发, 耗时较长
request if ${url} ~= /^http:\/\/1\.1\.1\.1\/loon-panel\/deep(\?|$)/i then script("https://raw.githubusercontent.com/MaYIHEI/patch/refs/heads/main/scripting/loon-panel/loon/loon-panel.js", {${groups}, ${net_retest}, ${notify}, ${auto_switch}, ${timeout}, ${test_url}, ${ip_url}, ${push_key}, ${widget_targets}}) with tag="Loon 面板深度检测", img_url="shield.lefthalf.filled.system", timeout=90
